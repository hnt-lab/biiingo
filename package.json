{
  "name": "biiingo",
  "version": "1.5.1",
  "private": true,
  "description": "Outil d'animation de soirées bingo",
  "scripts": {
    "check": "node scripts/check-syntax.mjs && node scripts/set-version.mjs --check",
    "test": "npm run test:unit && npm run test:rules && npm run test:browser",
    "test:browser": "node scripts/smoke-browser.mjs",
    "test:production": "node scripts/smoke-browser.mjs https://hnt-lab.github.io/biiingo",
    "test:unit": "node --test tests/cartons.test.js tests/core-utils.test.js tests/data.test.js tests/feedback.test.js tests/image-utils.test.js tests/mc-display.test.js tests/public-display.test.js tests/state.test.js tests/version.test.js",
    "test:rules": "firebase emulators:exec --project demo-biiingo --only firestore \"node --test firebase-tests/firestore.rules.test.mjs\"",
    "version:set": "node scripts/set-version.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "firebase": "12.18.0",
    "firebase-tools": "15.28.1",
    "playwright-core": "1.62.1"
  }
}
