rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function soiree(id) {
      return get(/databases/$(database)/documents/soirees/$(id)).data;
    }

    function isMc(id) {
      return signedIn() && request.auth.uid in soiree(id).mcUids;
    }

    function registreExists(ownerUid) {
      return exists(/databases/$(database)/documents/registres/$(ownerUid));
    }

    function isCollaborator(ownerUid) {
      return signedIn() && (
        request.auth.uid == ownerUid
        || (
          registreExists(ownerUid)
          && request.auth.uid in get(/databases/$(database)/documents/registres/$(ownerUid)).data.memberUids
        )
      );
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    match /soirees/{id} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.code is string
        && request.resource.data.code.size() == 4
        && request.resource.data.mcUids is list
        && request.resource.data.mcUids.size() == 1
        && request.auth.uid in request.resource.data.mcUids;

      // Les joueurs et écrans publics sont authentifiés anonymement avant de lire une soirée.
      allow read: if signedIn();

      allow update: if signedIn() && (
        request.auth.uid in resource.data.mcUids
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mcUids'])
          && request.resource.data.mcUids.hasAll(resource.data.mcUids)
          && request.resource.data.mcUids.size() == resource.data.mcUids.size() + 1
          && request.auth.uid in request.resource.data.mcUids
        )
      );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /joueurs/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isMc(id));
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow delete: if signedIn() && (request.auth.uid == uid || isMc(id));
      }
    }

    match /registres/{ownerUid} {
      allow read: if isCollaborator(ownerUid);

      allow create: if signedIn() && (
        request.auth.uid == ownerUid
        || (
          request.resource.data.accessSoireeId is string
          && soiree(request.resource.data.accessSoireeId).ownerUid == ownerUid
          && isMc(request.resource.data.accessSoireeId)
          && request.resource.data.memberUids is list
          && request.auth.uid in request.resource.data.memberUids
        )
      );

      allow update: if signedIn() && (
        request.auth.uid == ownerUid
        || (
          isCollaborator(ownerUid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['noms'])
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'accessSoireeId'])
          && (
            (
              !resource.data.keys().hasAny(['memberUids'])
              && request.resource.data.memberUids.size() == 1
            )
            || (
              request.resource.data.memberUids.hasAll(resource.data.memberUids)
              && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
            )
          )
          && request.auth.uid in request.resource.data.memberUids
          && soiree(request.resource.data.accessSoireeId).ownerUid == ownerUid
          && isMc(request.resource.data.accessSoireeId)
        )
      );

      allow delete: if signedIn() && request.auth.uid == ownerUid;
    }

    match /sons/{docId} {
      allow read: if signedIn();
      allow create: if request.resource.data.uid is string
        && isCollaborator(request.resource.data.uid);
      allow update: if request.resource.data.uid == resource.data.uid
        && isCollaborator(resource.data.uid);
      allow delete: if isCollaborator(resource.data.uid);
    }

    match /medias/{docId} {
      allow read: if signedIn();
      allow create: if request.resource.data.soireeId is string
        && isMc(request.resource.data.soireeId);
      allow update: if request.resource.data.soireeId == resource.data.soireeId
        && isMc(resource.data.soireeId);
      allow delete: if isMc(resource.data.soireeId);
    }

    match /feedback/{id} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'texte', 'contact', 'origine', 'nom', 'uid', 'version', 'ts'
        ])
        && request.resource.data.texte is string
        && request.resource.data.texte.size() > 0
        && request.resource.data.texte.size() <= 3000
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 80
        && request.resource.data.origine in ['mc', 'profil', 'joueur']
        && request.resource.data.nom is string
        && request.resource.data.nom.size() <= 80
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.version is string;
    }
  }
}
